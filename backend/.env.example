# DataAlphaOne backend configuration.
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# Values marked REQUIRED have no usable default.

DEBUG=false
CORS_ORIGINS=["http://localhost:5173"]

# ── Sessions ─────────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION: "redis".
# The production container runs uvicorn with --workers 4. With "memory", a
# session lives in one worker's process only, so requests that land on the other
# three return 401 — users appear to log in and are then logged out at random.
SESSION_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# Local dev only: with SESSION_BACKEND=memory, key-pair dev-login sessions are
# written here so a backend restart does not force a re-login. OAuth sessions
# are deliberately NEVER persisted — they hold live access tokens.
SESSION_STORE=file
SESSION_DIR=.sessions

# ── Chat history ─────────────────────────────────────────────────────────────
CONVERSATION_STORE=file
CONVERSATION_DIR=.conversations
CONVERSATION_TTL_SECONDS=2592000

# ── Snowflake ────────────────────────────────────────────────────────────────
# REQUIRED. Account identifier, e.g. ABC12345 or xy12345.us-east-1
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
# Fallback role for the DEV key-pair service account only — it has no user to
# inherit a role from. It is NOT applied to a real signed-in user: an OAuth
# session connects under that user's own Snowflake role, which is what makes
# per-user database access work. Setting this does not change what any
# signed-in user can reach.
SNOWFLAKE_DEFAULT_ROLE=

# Roles the signed-in user may switch to in the UI (comma-separated or JSON).
# Empty hides the picker. Switching still requires Snowflake to grant the role.
#   SNOWFLAKE_AVAILABLE_ROLES=PRIVATE_CREDIT_ANALYST,DATAALPHA_ADMIN
SNOWFLAKE_AVAILABLE_ROLES=

# ── Who may edit semantic layers ─────────────────────────────────────────────
# Snowflake roles allowed into the admin surface (semantic layer editor).
# Comma-separated, or a JSON list. Compared case-insensitively against the
# user's ACTIVE role.
#
# EMPTY MEANS NOBODY. That is deliberate — a deployment that forgets to set
# this locks admin rather than opening it to everyone. Set it per environment.
#
# Admin grants the ability to AUTHOR, not wider reach: an admin still only
# sees and edits layers for databases their Snowflake role can access.
#
#   ADMIN_ROLES=DATAALPHA_ADMIN
ADMIN_ROLES=

# ── Connect Snowflake (OAuth) — optional, NOT how people sign in ─────────────
# People sign in with an email and password (see "App accounts" below). This
# integration is only for a signed-in person who wants Snowflake DATA: they press
# "Connect Snowflake", and their queries then run as them, under their own role.
# Leave both blank and the app runs without it: sign-in is unaffected, and
# Snowflake data is simply not offered.
#
# Create the integration in Snowflake as ACCOUNTADMIN, then read the values with:
#
#   SELECT SYSTEM$SHOW_OAUTH_CLIENT_SECRETS('<INTEGRATION_NAME>');
#
# Snowflake permits only ONE redirect URI per integration, so each environment
# (dev / staging / prod) needs its own SECURITY INTEGRATION. The URI below must
# match that integration EXACTLY. Snowflake accepts http:// only for localhost —
# any deployed environment must be https://.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8001/api/v1/auth/callback
# Optional; derived from SNOWFLAKE_ACCOUNT when empty.
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=

# ── Cookies / crypto ─────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
SESSION_COOKIE_NAME=session_id
SESSION_TTL_SECONDS=86400
OAUTH_STATE_TTL_SECONDS=600
FRONTEND_URL=http://localhost:5173

# REQUIRED IN PRODUCTION. Encrypts Snowflake refresh tokens at rest. If left
# empty the app generates one per process — which, with 4 workers, means four
# different keys and tokens that cannot be decrypted by the worker that did not
# create them. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Set COOKIE_SECURE=true wherever the app is served over https, or the browser
# will discard the session cookie.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Anthropic ────────────────────────────────────────────────────────────────
# REQUIRED for chat; AI routes return 503 without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SQL=claude-sonnet-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_AGENT=claude-sonnet-5
AGENT_MAX_ITERATIONS=12
QUERY_ROW_LIMIT=100

# ── Local development sign-in — REMOVE FOR ANY DEPLOYMENT ────────────────────
# Authenticates as a shared key-pair service account and skips the web app's
# login entirely: anyone who can reach the port gets a session. Requires DEBUG
# AND this flag AND the key material, so it cannot switch itself on by accident.
# Not used by the web app's ordinary Snowflake access, which is always the
# signed-in person's own connection. Leave it off; delete the block when no
# developer needs it.
DEV_LOGIN_ENABLED=false
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# ── Excel reports ────────────────────────────────────────────────────────────
# Rows one query may write into a workbook. This bounds the GENERATOR, not the
# warehouse: measured at ~0.65ms/row, so 50,000 rows takes ~35s and 100,000
# takes ~63s. Time is cheap; peak memory is the thing to watch, so budget per
# concurrent run. Hitting the cap is never silent — a report cut short is
# refused unless the caller opts into a partial extract.
MCP_EXCEL_MAX_ROWS=50000

# Rows a saved dashboard panel fetches from Snowflake. Chat stays at 100 rows;
# a dashboard's rows go to the page only, where the table shows them 100 at a
# time. Past this the panel says it shows only the first rows.
MCP_DASHBOARD_MAX_ROWS=5000

# Where uploaded templates and generated workbooks live. `local` writes under
# the backend directory, which a container loses on redeploy; `s3` needs a
# bucket and keeps them.
EXCEL_STORAGE_BACKEND=local
EXCEL_S3_BUCKET=
EXCEL_S3_PREFIX=

# How many of one dashboard's panel queries run at once (1-8). 1 runs them one
# after another, as before. Every dashboard in a backend process shares a cap
# of 8 queries at a time (32 across production's 4 worker processes), so many
# users loading together queue rather than flood the warehouse.
DASHBOARD_QUERY_CONCURRENCY=1

# Data groups (Configuration -> Data groups). Set up with backend/sql/data_groups.sql.
# false: dashboards are filed by data group but nobody loses sight of anything.
# true: people see only what shares a group with them, plus anything in no
# group. Admins always see everything. Turn on once groups and members are in place.
DATA_GROUPS_ENFORCED=false
# MCP_DATA_GROUPS_TABLE=LOAN.PUBLIC.MCP_DATA_GROUPS
# MCP_DATA_GROUP_MEMBERS_TABLE=LOAN.PUBLIC.MCP_DATA_GROUP_MEMBERS
# MCP_DATA_GROUP_RESOURCES_TABLE=LOAN.PUBLIC.MCP_DATA_GROUP_RESOURCES

# Long chats: once the history reaches about this many tokens, the turns before
# the most recent CHAT_SUMMARY_KEEP_TURNS are condensed into a summary for the
# model. The user still sees every message. 0 turns it off.
CHAT_SUMMARY_TRIGGER_TOKENS=50000
CHAT_SUMMARY_KEEP_TURNS=4

# SQL Server connections, added by an administrator on the Connections page.
# Hosts a connection may point at, comma-separated (host or IP, no port).
# Empty allows none. Saved passwords are encrypted with TOKEN_ENCRYPTION_KEY,
# which must then be set: without it every worker invents its own key and
# cannot read a password another worker saved.
DB_CONNECTION_ALLOWED_HOSTS=
# TDS protocol version for SQL Server logins: 7.4 for SQL Server 2012 and later,
# 7.3 for 2008. Left to the driver, every login waited out a timeout first.
SQLSERVER_TDS_VERSION=7.4
# How long a source's tables and columns are reused before the server is asked
# again. Shared by every worker. Lower it if schemas change during the day;
# raise it if the server is slow to answer.
SOURCE_CATALOGUE_SECONDS=3600
# Connections are kept in the app's SQLite file (APP_DB_PATH). This is the
# Snowflake table they were kept in before: read once, to copy them across.
MCP_DB_CONNECTIONS_TABLE=LOAN.PUBLIC.MCP_DB_CONNECTIONS

# App accounts, and the app's own records (connections, SQL Server
# dashboards), kept in a SQLite file.
# On a server the file must be on a mounted volume (see docker-compose), or a
# redeploy deletes every account.
APP_DB_PATH=data/app.db
# Who may create an account: open (anyone), invite (an administrator's
# invitation link), or closed (nobody; no new accounts). Keep "invite" on a
# real deployment until SMTP, rate limiting and password reset are verified:
# "open" needs working email (a new account must confirm its address) and the
# app refuses to start with "open" and no SMTP outside DEBUG.
SIGNUP_MODE=invite
# Accounts with these emails are administrators ONCE THEIR EMAIL IS CONFIRMED.
# How the first administrator of a new deployment is made. Comma-separated.
# Signing up never makes anyone an administrator by itself, and neither does a
# Snowflake role: more administrators are made on the Users page.
ADMIN_EMAILS=
# Must a new account open a link emailed to it before it can sign in? true (the
# default) proves the person owns the address, and is what a real deployment
# wants. false gives a plain sign-up and sign-in with no email step: fine for
# local use. With it false nothing proves an address, so ADMIN_EMAILS can no
# longer make an administrator by itself: run
#   pipenv run python scripts/make_admin.py you@company.com
EMAIL_VERIFICATION_REQUIRED=true
# Passwords: at least this many characters, not on the bundled list of common
# and breached passwords, and not containing the email's name. Stored as
# Argon2id; the cost below is RFC 9106's low-memory profile.
PASSWORD_MIN_LENGTH=10
# argon2id (default) or scrypt. "scrypt" is the first stage of a rollout: the
# new code is live but writes the older format, so the previous release can
# still read every password while rolling back is possible. See DEPLOYMENT.md.
PASSWORD_HASH_ALGORITHM=argon2id
PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_MEMORY_KIB=65536
PASSWORD_HASH_PARALLELISM=4
# How long a password-reset link works, in minutes.
PASSWORD_RESET_TTL_MINUTES=30

# Outgoing email, for confirmation, invitation and password-reset links. Any
# SMTP server works:
# Office 365 (smtp.office365.com), Google Workspace (smtp.gmail.com), AWS SES,
# SendGrid. Without SMTP_HOST nothing is sent; with DEBUG=true the link is
# written to the backend log instead, for local testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=DataAlpha One <no-reply@example.com>
# starttls (port 587), ssl (port 465), or none
SMTP_SECURITY=starttls
# Local development only: write emails, links included, to the backend log.
# The app REFUSES TO START with this on outside DEBUG: a link in a log lets
# anyone who can read it take over an account.
EMAIL_LINKS_IN_LOG=false
EMAIL_VERIFICATION_TTL_HOURS=24

# ── Sign-in rate limits ──────────────────────────────────────────────────────
# Attempts per window (seconds), counted per client IP and, where the request
# names one, per email. In Redis when SESSION_BACKEND=redis (shared by every
# worker); in process memory otherwise, which is only right for one local
# process. If Redis cannot be reached the sign-in routes answer 503 rather than
# allow unlimited guesses. A refused request is 429 with Retry-After, and says
# nothing about whether the account exists.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SIGN_IN_PER_IP=30
RATE_LIMIT_SIGN_IN_PER_EMAIL=10
RATE_LIMIT_SIGN_IN_WINDOW=900
RATE_LIMIT_SIGN_UP_PER_IP=5
RATE_LIMIT_SIGN_UP_WINDOW=3600
RATE_LIMIT_EMAIL_PER_IP=10
RATE_LIMIT_EMAIL_PER_EMAIL=3
RATE_LIMIT_EMAIL_WINDOW=3600
RATE_LIMIT_TOKEN_PER_IP=10
RATE_LIMIT_TOKEN_WINDOW=900
# Reverse proxies whose X-Forwarded-For is believed, as IPs or CIDRs, comma
# separated. In production: the Docker network Traefik and nginx sit on
# (`docker network inspect web`). EMPTY MEANS NONE: the client is whoever
# connected, and an X-Forwarded-For header is ignored, because anyone can send
# one. Behind a proxy, leaving this empty makes every request look like it came
# from the proxy, so the per-IP limits become one bucket for all your users.
TRUSTED_PROXIES=
