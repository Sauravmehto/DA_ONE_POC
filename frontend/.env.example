
# Show the Report Builder nav item. Unset (or anything but "true")
# hides it. Leave unset in deployed environments until the multi-block
# flow works behind multiple workers.
VITE_SHOW_REPORT_BUILDER=false

# Show the connector picker, the Snowflake card, and "add a connection".
# Unset (or anything but "true") hides them: sign-in lands on /files.
# Leave unset in this deployment. Set to true to restore the picker.
# VITE_SHOW_CONNECTORS=true
